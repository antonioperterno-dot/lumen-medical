# =============================================================================
# LUMEN — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit .env.local.
# =============================================================================

# Set to true in the production host to require one-use codes created with
# `npm run invite:create`. Leave unset/false for local development.
NEXT_PUBLIC_REQUIRE_INVITE="false"

# -----------------------------------------------------------------------------
# MICROSERVICE 1 — Turso (libSQL edge): the medical resources catalogue
# Create a database with:  turso db create lumen
# Then run:                turso db show lumen --url
#                          turso db tokens create lumen
# -----------------------------------------------------------------------------
TURSO_DATABASE_URL="libsql://lumen-your-org.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOi..."

# -----------------------------------------------------------------------------
# MICROSERVICE 2 — Firebase (Auth + Firestore): users, badges, progress, quiz
# Firebase console: Project settings, Your apps, Web app, SDK config
# These are public values (shipped to the browser) and safe to expose.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="lumen-medical.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="lumen-medical"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="lumen-medical.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# -----------------------------------------------------------------------------
# Server-side Firebase Admin (used by /api/progress and /api/quiz to write
# progress and attempts). Service account: Firebase console, Project settings,
# Service accounts, Generate new private key. Keep the private key secret.
# The key may contain literal newlines — wrap it in double quotes and keep the
# \n escapes exactly as they appear in the JSON file.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID="lumen-medical"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@lumen-medical.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
