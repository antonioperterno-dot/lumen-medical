116|/** Subscribes to local changes; returns the unsubscribe function. */
117|export function subscribe(listener: () => void): () => void {
118|  if (typeof window === "undefined") return () => undefined;
119|  window.addEventListener(PROGRESS_CHANGED_EVENT, listener);
120|  return () => window.removeEventListener(PROGRESS_CHANGED_EVENT, listener);
121|}
