{
  "name": "lumen-medical",
  "version": "1.0.0",
  "private": true,
  "description": "LUMEN - Offline-first medical education PWA for medical students in Uganda",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:turso": "node --env-file=.env.local scripts/seed-turso.mjs",
    "paper:import": "node --env-file=.env.local scripts/import-paper.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "deploy:vercel": "vercel deploy --prod",
    "deploy:firebase": "next build && firebase deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jsonpointer": "^5.0.1",
    "leven": "^4.1.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.12",
    "@types/node": "^20.17.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.28",
    "serwist": "^9.5.12",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "//allowScripts": "npm 11 blocks install/postinstall scripts unless a package is listed here. Firebase, sharp, and protobufjs use their install scripts to finish installing runtime helpers and native binaries.",
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "postcss": "$postcss",
    "uuid": "11.1.1",
    "browserslist": "4.29.3"
  }
}
